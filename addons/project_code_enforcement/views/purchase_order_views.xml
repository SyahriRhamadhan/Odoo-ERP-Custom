<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_project_code" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.project.code</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='partner_id'][1]" position="after">
                <field name="fabrication_project_id"/>
            </xpath>
        </field>
    </record>
</odoo>
