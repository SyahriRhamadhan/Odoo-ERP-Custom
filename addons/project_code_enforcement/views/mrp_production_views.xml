<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_inherit_project_code" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.project.code</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='product_id'][1]" position="after">
                <field name="fabrication_project_id"/>
            </xpath>
        </field>
    </record>
</odoo>
