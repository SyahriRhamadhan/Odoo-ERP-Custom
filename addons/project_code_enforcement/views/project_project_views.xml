<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_form_inherit_project_code" model="ir.ui.view">
        <field name="name">project.project.form.inherit.project.code</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='name'][1]" position="after">
                <field name="project_code"/>
            </xpath>
        </field>
    </record>
</odoo>
